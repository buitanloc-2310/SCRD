{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skyfirst-exam-portal",
  "main": "src/index.js",
  "compatibility_date": "2026-10-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "CONFIRM_ACTUAL_D1_DATABASE_NAME",
      "database_id": "6006fe24-6278-4989-8d94-fd4734d71679"
    }
  ],
  "vars": {
    "CONTROL_ORIGIN": "https://scrd.skyfirst.io.vn"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "scrd-files"
    }
  ]
}
